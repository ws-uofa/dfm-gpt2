{
  "data": {
    "packing_mode": "cross_article",
    "block_size": 1024,
    "chunk_size": 16,
    "top_k": 16,
    "continuation": "append",
    "exclude_current_block": true,
    "exclude_current_article": false,
    "candidate_pool": 2048,
    "index_type": "ivf_pq",
    "metric": "inner_product",
    "nlist": 10942,
    "nprobe": 32,
    "pq_code_size": 64,
    "pq_nbits": 8
  },
  "model": {
    "fusion_layers": [0, 2, 5, 8, 10, 11],
    "traditional_fusion_timing": "pre_attn",
    "transformer_only_fusion_timing": "post_attn",
    "memory_dim": 1024,
    "projector_hidden": 768,
    "memory_attention_heads": 12,
    "gate_type": "token_wise_per_head",
    "gate_init": 0.0,
    "memory_attention_dropout": 0.1,
    "reader_dim": 256,
    "reader_layers": 2,
    "reader_heads": 8,
    "reader_ff_multiplier": 4,
    "reader_dropout": 0.0,
    "reader_topology": "causal",
    "reader_write": "residual",
    "reader_sharing": "independent"
  },
  "training": {
    "loss": "ce",
    "margin": 0.05,
    "margin_weight": 0.1,
    "preserve_negative_rng": true,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "warmup_steps": 0,
    "max_grad_norm": 1.0,
    "seed": 42
  }
}
