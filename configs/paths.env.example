# Copy to configs/local.env (ignored by Git) and adjust when storage moves.
export DFM_REPO_ROOT=/plm-shared/sunsiyuan/dfm-gpt2
export GPT2_MODEL=/plm-dhw/sunsiyuan/DEEPFUSIONMEM/models/MLPMemory/gpt2-small
export EMBEDDING_MODEL=/plm-dhw/sunsiyuan/DEEPFUSIONMEM/models/Qwen3-Embedding-0.6B
export WIKITEXT103=/plm-dhw/sunsiyuan/DEEPFUSIONMEM/datasets/wikitext-103-raw-v1
export WT103_ARTIFACT=/plm-dhw/sunsiyuan/DEEPFUSIONMEM/artifacts/wikitext103-db-ablation-v1/cross_article
export DFM_RUNS=/plm-shared/sunsiyuan/DEEPFUSIONMEM_FAST/runs/dfm-gpt2
export PYTHON_BIN=/plm-shared/sunsiyuan/.venvs/dfm/bin/python

# Keep caches and temporary high-I/O files on Sunsiyuan's fast shared storage.
export HF_HOME=/plm-shared/sunsiyuan/DEEPFUSIONMEM_FAST/cache/huggingface
export HF_DATASETS_CACHE=/plm-shared/sunsiyuan/DEEPFUSIONMEM_FAST/cache/huggingface/datasets
export DFM_TMPDIR=/plm-shared/sunsiyuan/DEEPFUSIONMEM_FAST/cache/tmp
export TOKENIZERS_PARALLELISM=false
